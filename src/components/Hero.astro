---
---

<!-- ─── HERO SECTION ─── -->
<section class="hero" id="hero" aria-label="Introduction & Overview">
  <!-- Glowing Background Orbs & Canvases -->
  <div class="hero-orb orb1" aria-hidden="true"></div>
  <div class="hero-orb orb2" aria-hidden="true"></div>
  <div class="hero-orb orb3" aria-hidden="true"></div>
  <div class="hero-grid-pattern" aria-hidden="true"></div>
  <canvas id="heroCanvas" aria-hidden="true"></canvas>

  <!-- Giant Bold Typographic Name Block with Dynamic Center Photo -->
  <div class="name-block" role="banner">
    <span class="sr-only">Kuldeep Sharma</span>
    <span class="name-line" aria-hidden="true">KULDEEP</span>
    <span class="name-line" aria-hidden="true">SHARMA</span>

    <!-- High-Impact Central Photo with 3D Tilt & Cyber Aura -->
    <div class="hero-photo-wrapper" id="heroPhotoWrapper">
      <div class="hero-photo-3d" id="heroPhoto3D">
        <div class="hero-aura-ring" aria-hidden="true"></div>
        <div class="hero-dashed-ring" aria-hidden="true"></div>
        <div class="hero-dashed-ring-2" aria-hidden="true"></div>

        <div class="hero-photo-frame">
          <img 
            src="/linkedin_photo.jpg" 
            alt="Kuldeep Sharma - Head of Growth Systems & Operations" 
            width="220" 
            height="220" 
            loading="eager" 
            fetchpriority="high"
            decoding="async"
            onerror="this.onerror=null;this.src='/All info/Kuldeep.png';" 
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Primary Headline -->
  <h1 class="hero-headline-sub r">
    Architecting Autonomous Growth Engines & <span class="cyan-text">High-Velocity Revenue Systems</span>
  </h1>

  <!-- Hero CTA Buttons -->
  <div class="hero-actions r">
    <a href="https://www.linkedin.com/in/kuldeepsharma09/" target="_blank" rel="noopener" class="btn-li-light" aria-label="Connect with Kuldeep Sharma on LinkedIn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 4px;" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28z"/></svg>
      Connect on LinkedIn (4.8K+) ↗
    </a>
  </div>
</section>

<script is:inline>
  // Interactive 3D Tilt on Central Hero Image
  (function initHero3D() {
    const heroWrapper = document.getElementById("heroPhotoWrapper");
    const hero3D = document.getElementById("heroPhoto3D");
    const heroSec = document.getElementById("hero");
    if (!heroWrapper || !hero3D) return;

    function resetTilt() {
      hero3D.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg)";
      hero3D.style.transition = "transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)";
    }

    const interactZone = heroSec || heroWrapper;
    interactZone.addEventListener("mousemove", e => {
      if (window.innerWidth <= 960) return;
      const rect = heroWrapper.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      const rawDeltaX = (e.clientX - centerX) / (window.innerWidth / 2);
      const rawDeltaY = (e.clientY - centerY) / (window.innerHeight / 2);

      const deltaX = Math.max(-1, Math.min(1, rawDeltaX));
      const deltaY = Math.max(-1, Math.min(1, rawDeltaY));

      const rotateY = deltaX * 10;
      const rotateX = -deltaY * 10;

      hero3D.style.transition = "transform 0.08s ease-out";
      hero3D.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });

    interactZone.addEventListener("mouseleave", resetTilt);

    window.addEventListener("scroll", () => {
      if (window.scrollY > 250) {
        resetTilt();
      }
    }, { passive: true });
  })();

  // Letter by Letter Name Stagger
  (function splitName() {
    document.querySelectorAll(".name-line").forEach((line, li) => {
      const txt = line.textContent.trim();
      line.textContent = "";
      [...txt].forEach((ch, ci) => {
        const s = document.createElement("span");
        s.className = "name-char";
        s.style.animationDelay = (li * 0.18 + ci * 0.045 + 0.1) + "s";
        s.textContent = ch;
        line.appendChild(s);
      });
    });
  })();

  // Hero Constellation Particle Canvas
  (function initHeroCanvas() {
    const canvas = document.getElementById("heroCanvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    let W, H;
    const count = 75;
    let particles = [];
    let mouse = { x: -1000, y: -1000, active: false };

    function resize() {
      W = canvas.width = canvas.offsetWidth;
      H = canvas.height = canvas.offsetHeight;
      initParticles();
    }

    function initParticles() {
      particles = [];
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * W,
          y: Math.random() * H,
          r: Math.random() * 1.8 + 0.6,
          vx: (Math.random() - 0.5) * 0.35,
          vy: (Math.random() - 0.5) * 0.35,
          color: Math.random() > 0.5 ? "rgba(255, 133, 51," : "rgba(255, 160, 92,",
          alpha: Math.random() * 0.6 + 0.2
        });
      }
    }

    window.addEventListener("resize", resize);
    window.addEventListener("mousemove", e => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
    });
    window.addEventListener("touchstart", e => {
      if (e.touches.length > 0) {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.touches[0].clientX - rect.left;
        mouse.y = e.touches[0].clientY - rect.top;
        mouse.active = true;
      }
    }, { passive: true });
    window.addEventListener("touchmove", e => {
      if (e.touches.length > 0) {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.touches[0].clientX - rect.left;
        mouse.y = e.touches[0].clientY - rect.top;
        mouse.active = true;
      }
    }, { passive: true });
    window.addEventListener("touchend", () => {
      mouse.active = false;
      mouse.x = -1000;
      mouse.y = -1000;
    }, { passive: true });

    resize();

    function draw() {
      ctx.clearRect(0, 0, W, H);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0) p.x = W; if (p.x > W) p.x = 0;
        if (p.y < 0) p.y = H; if (p.y > H) p.y = 0;

        if (mouse.active) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 120) {
            const force = (120 - dist) / 120;
            p.x += (dx / dist) * force * 1.5;
            p.y += (dy / dist) * force * 1.5;
          }
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = p.color + p.alpha + ")";
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dist = Math.hypot(p.x - p2.x, p.y - p2.y);
          if (dist < 90) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(255, 133, 51, ${(1 - dist / 90) * 0.16})`;
            ctx.lineWidth = 0.7;
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(draw);
    }
    draw();
  })();
</script>
