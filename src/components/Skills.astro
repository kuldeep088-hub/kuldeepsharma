---
---

<!-- ─── SKILLS & GAUGES SECTION ─── -->
<section class="sec sec-alt" id="skills">
  <div class="r">
    <div class="sec-label">Skills & Technology Matrix</div>
    <h2 class="sec-title">Engineered with<br><span>modern AI & growth stacks</span>.</h2>
    <p class="sec-sub">A synergy of technical computer science execution and business-driven growth strategy.</p>
  </div>

  <div class="skills-grid">
    <!-- Category Cards -->
    <div class="skill-category-list r">
      <div class="skill-cat-card">
        <div class="skill-cat-header">
          <span class="skill-cat-icon">🤖</span>
          <span class="skill-cat-title">AI Automation & Agents</span>
        </div>
        <div class="skill-tags">
          <span class="s-tag hot">n8n Orchestration</span>
          <span class="s-tag">Make.com</span>
          <span class="s-tag hot">Prompt Engineering</span>
          <span class="s-tag">OpenAI API</span>
          <span class="s-tag">Custom Agents</span>
        </div>
      </div>

      <div class="skill-cat-card">
        <div class="skill-cat-header">
          <span class="skill-cat-icon">🔍</span>
          <span class="skill-cat-title">Search Intelligence (AEO / GEO / SEO)</span>
        </div>
        <div class="skill-tags">
          <span class="s-tag hot">AEO (Answer Engine)</span>
          <span class="s-tag hot">GEO (Generative Engine)</span>
          <span class="s-tag">Perplexity Ranking</span>
          <span class="s-tag">Semantic Schema</span>
          <span class="s-tag">Technical SEO</span>
        </div>
      </div>

      <div class="skill-cat-card">
        <div class="skill-cat-header">
          <span class="skill-cat-icon">📊</span>
          <span class="skill-cat-title">Paid Media & Funnel Optimization</span>
        </div>
        <div class="skill-tags">
          <span class="s-tag hot">Meta Ads Manager</span>
          <span class="s-tag">Conversion API</span>
          <span class="s-tag">D2C Scaling</span>
          <span class="s-tag">CAC Minimization</span>
          <span class="s-tag">High-ROAS Creatives</span>
        </div>
      </div>
    </div>

    <!-- Live Animated Gauges -->
    <div class="gauges-container r">
      <div class="gauges-header">
        <span>Execution Proficiency</span>
        <span style="font-size: 0.8rem; color: var(--orange); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">Verified Metrics</span>
      </div>
      <div class="gauges-grid">
        <div class="gauge-item">
          <div class="gauge-svg-wrap">
            <svg class="gauge-svg" viewBox="0 0 96 96">
              <circle class="gauge-track" cx="48" cy="48" r="42"></circle>
              <circle class="gauge-fill" cx="48" cy="48" r="42" stroke="url(#skillGrad)" data-pct="95"></circle>
            </svg>
            <div class="gauge-center-text"><span class="g-num">0</span>%</div>
          </div>
          <div class="gauge-label">SEO / AEO / GEO</div>
        </div>

        <div class="gauge-item">
          <div class="gauge-svg-wrap">
            <svg class="gauge-svg" viewBox="0 0 96 96">
              <circle class="gauge-track" cx="48" cy="48" r="42"></circle>
              <circle class="gauge-fill" cx="48" cy="48" r="42" stroke="url(#skillGrad)" data-pct="92"></circle>
            </svg>
            <div class="gauge-center-text"><span class="g-num">0</span>%</div>
          </div>
          <div class="gauge-label">AI Automation</div>
        </div>

        <div class="gauge-item">
          <div class="gauge-svg-wrap">
            <svg class="gauge-svg" viewBox="0 0 96 96">
              <circle class="gauge-track" cx="48" cy="48" r="42"></circle>
              <circle class="gauge-fill" cx="48" cy="48" r="42" stroke="url(#skillGrad)" data-pct="90"></circle>
            </svg>
            <div class="gauge-center-text"><span class="g-num">0</span>%</div>
          </div>
          <div class="gauge-label">Meta Ads & ROAS</div>
        </div>

        <div class="gauge-item">
          <div class="gauge-svg-wrap">
            <svg class="gauge-svg" viewBox="0 0 96 96">
              <circle class="gauge-track" cx="48" cy="48" r="42"></circle>
              <circle class="gauge-fill" cx="48" cy="48" r="42" stroke="url(#skillGrad)" data-pct="88"></circle>
            </svg>
            <div class="gauge-center-text"><span class="g-num">0</span>%</div>
          </div>
          <div class="gauge-label">B2B Pipelines</div>
        </div>

        <div class="gauge-item">
          <div class="gauge-svg-wrap">
            <svg class="gauge-svg" viewBox="0 0 96 96">
              <circle class="gauge-track" cx="48" cy="48" r="42"></circle>
              <circle class="gauge-fill" cx="48" cy="48" r="42" stroke="url(#skillGrad)" data-pct="94"></circle>
            </svg>
            <div class="gauge-center-text"><span class="g-num">0</span>%</div>
          </div>
          <div class="gauge-label">Growth Systems</div>
        </div>

        <div class="gauge-item">
          <div class="gauge-svg-wrap">
            <svg class="gauge-svg" viewBox="0 0 96 96">
              <circle class="gauge-track" cx="48" cy="48" r="42"></circle>
              <circle class="gauge-fill" cx="48" cy="48" r="42" stroke="url(#skillGrad)" data-pct="85"></circle>
            </svg>
            <div class="gauge-center-text"><span class="g-num">0</span>%</div>
          </div>
          <div class="gauge-label">Python & ML</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function initSkillGauges() {
    const skillsSec = document.getElementById("skills");
    if (skillsSec) {
      new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting) return;
          e.target.querySelectorAll(".gauge-item").forEach((item, idx) => {
            setTimeout(() => {
              const fill = item.querySelector(".gauge-fill");
              const numEl = item.querySelector(".g-num");
              if (!fill || !numEl) return;
              const pct = parseInt(fill.dataset.pct, 10);
              fill.style.strokeDashoffset = 264 * (1 - pct / 100);

              let current = 0;
              const step = Math.max(1, Math.round(pct / 35));
              const timer = setInterval(() => {
                current = Math.min(current + step, pct);
                numEl.textContent = current;
                if (current >= pct) clearInterval(timer);
              }, 25);
            }, idx * 120);
          });
        });
      }, { threshold: 0.1 }).observe(skillsSec);
    }
  })();
</script>
