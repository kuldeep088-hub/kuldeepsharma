---
---

<!-- ─── DEPLOYED TOOLS SECTION ─── -->
<section class="sec" id="tools" aria-label="Deployed Tools and Micro-Products - Kuldeep Sharma">
  <span id="services" class="sr-only" aria-hidden="true"></span>
  <div class="r">
    <div class="sec-label">Shipped Software · Production-Grade Web Utilities</div>
    <h2 class="sec-title">
      Real Tools I Built & Deployed.<br>
      <span>(Try the fun tool I made!)</span>
    </h2>
    <p class="sec-sub">
      Production web utilities built from scratch and shipped to production. 100% client-side execution, zero server uploads, and crafted for pure speed.
    </p>
  </div>

  <div class="tools-grid">
    <!-- Tool 1: FreeCompressImage.com -->
    <div class="tool-card r">
      <div class="tool-card-glow" aria-hidden="true"></div>
      <div class="tool-top">
        <div class="tool-badge-wrap">
          <span class="tool-status-dot"></span>
          <span class="tool-status-text">Live in Production</span>
        </div>
        <span class="tool-type-pill">Free Web Utility</span>
      </div>

      <div class="tool-header">
        <div class="tool-icon-box">🖼️</div>
        <div>
          <h3 class="tool-name">FreeCompressImage.com</h3>
          <p class="tool-tagline">Free Online Image Compressor & Photo Resizer</p>
        </div>
      </div>

      <p class="tool-desc">
        A fast, privacy-first web application that compresses and resizes photos to exact KB targets (50KB, 100KB, 200KB) with zero quality loss. Uses client-side canvas quantization with zero remote server uploads.
      </p>

      <div class="tool-highlights">
        <div class="tool-highlight-item">
          <span class="th-num">100%</span>
          <span class="th-label">In-Browser Privacy</span>
        </div>
        <div class="tool-highlight-item">
          <span class="th-num">&lt;50KB</span>
          <span class="th-label">Exact Target Sizes</span>
        </div>
        <div class="tool-highlight-item">
          <span class="th-num">3+</span>
          <span class="th-label">Formats (WebP/JPG/PNG)</span>
        </div>
      </div>

      <div class="tool-tags">
        <span class="tool-tag">Exact KB Targets</span>
        <span class="tool-tag">WebP / JPG / PNG</span>
        <span class="tool-tag">Zero Server Uploads</span>
        <span class="tool-tag">Lossless Quantization</span>
        <span class="tool-tag">100% Client-Side</span>
      </div>

      <div class="tool-actions">
        <a 
          href="https://freecompressimage.com/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-tool-launch"
        >
          <span>Try FreeCompressImage</span>
          <span class="launch-arrow">↗</span>
        </a>
      </div>
    </div>

    <!-- Tool 2: PDFToolsAi.com -->
    <div class="tool-card r">
      <div class="tool-card-glow" aria-hidden="true"></div>
      <div class="tool-top">
        <div class="tool-badge-wrap">
          <span class="tool-status-dot"></span>
          <span class="tool-status-text">Live in Production</span>
        </div>
        <span class="tool-type-pill">AI Document Suite</span>
      </div>

      <div class="tool-header">
        <div class="tool-icon-box">📑</div>
        <div>
          <h3 class="tool-name">PDFToolsAi.com</h3>
          <p class="tool-tagline">All-in-One In-Browser PDF Suite & Document Utilities</p>
        </div>
      </div>

      <p class="tool-desc">
        A complete client-side document workstation built on WebAssembly (Wasm). Compress PDFs to exact target byte sizes, merge, split, rotate, convert to Word/Excel/JPG, and crop ecommerce shipping labels with zero file uploads.
      </p>

      <div class="tool-highlights">
        <div class="tool-highlight-item">
          <span class="th-num">Wasm</span>
          <span class="th-label">Client-Side Engine</span>
        </div>
        <div class="tool-highlight-item">
          <span class="th-num">Exact KB</span>
          <span class="th-label">PDF Compression</span>
        </div>
        <div class="tool-highlight-item">
          <span class="th-num">15+</span>
          <span class="th-label">Document Utilities</span>
        </div>
      </div>

      <div class="tool-tags">
        <span class="tool-tag">WebAssembly Engine</span>
        <span class="tool-tag">Exact KB Compression</span>
        <span class="tool-tag">PDF Merge & Split</span>
        <span class="tool-tag">Label Cropper (Meesho/Flipkart)</span>
        <span class="tool-tag">Zero File Uploads</span>
      </div>

      <div class="tool-actions">
        <a 
          href="https://pdftoolsai.com/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-tool-launch"
        >
          <span>Try PDF Tools AI</span>
          <span class="launch-arrow">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
  }

  .tool-card {
    background: rgba(15, 17, 23, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(14px);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .tool-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 133, 51, 0.5);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5), 0 0 40px rgba(255, 133, 51, 0.15);
  }

  .tool-card-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle at 100% 0%, rgba(255, 133, 51, 0.12), transparent 70%);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .tool-card:hover .tool-card-glow {
    opacity: 1;
    background: radial-gradient(circle at 100% 0%, rgba(255, 133, 51, 0.22), transparent 70%);
  }

  .tool-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.6rem;
  }

  .tool-badge-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
    border-radius: 999px;
  }

  .tool-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: pulseDot 2s infinite ease-in-out;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .tool-status-text {
    font-size: 0.72rem;
    font-weight: 700;
    color: #4ade80;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tool-type-pill {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--orange);
    background: var(--orange-soft);
    border: 1px solid rgba(255, 133, 51, 0.25);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }

  .tool-header {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.2rem;
  }

  .tool-icon-box {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    flex-shrink: 0;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .tool-card:hover .tool-icon-box {
    transform: scale(1.08) rotate(4deg);
    border-color: var(--orange);
  }

  .tool-name {
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  .tool-tagline {
    font-size: 0.85rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .tool-desc {
    color: var(--gray);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 1.6rem;
  }

  .tool-highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    margin-bottom: 1.5rem;
  }

  .tool-highlight-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .th-num {
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .th-label {
    font-size: 0.68rem;
    color: var(--gray);
    font-weight: 500;
    margin-top: 0.15rem;
    line-height: 1.25;
  }

  .tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2rem;
    margin-top: auto;
  }

  .tool-tag {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 133, 51, 0.08);
    border: 1px solid rgba(255, 133, 51, 0.2);
    color: #ffa05c;
    transition: all 0.2s ease;
  }

  .tool-card:hover .tool-tag {
    background: rgba(255, 133, 51, 0.15);
    border-color: rgba(255, 133, 51, 0.4);
    color: #ffffff;
  }

  .tool-actions {
    margin-top: auto;
  }

  .btn-tool-launch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.85rem 1.4rem;
    background: linear-gradient(135deg, rgba(255, 133, 51, 0.15), rgba(255, 133, 51, 0.05));
    border: 1px solid rgba(255, 133, 51, 0.4);
    border-radius: 10px;
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .launch-arrow {
    font-size: 1.1rem;
    transition: transform 0.3s ease;
  }

  .btn-tool-launch:hover {
    background: var(--orange);
    color: #07080a;
    border-color: var(--orange);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(255, 133, 51, 0.35);
  }

  .btn-tool-launch:hover .launch-arrow {
    transform: translate(3px, -3px);
  }

  @media (max-width: 900px) {
    .tools-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .tool-card {
      padding: 1.8rem 1.4rem;
    }

    .tool-name {
      font-size: 1.25rem;
    }
  }
</style>
