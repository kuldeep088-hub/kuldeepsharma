<!-- ─── STATS COUNTER ─── -->
<div class="stats">
  <div class="stat-item r">
    <div class="stat-num" data-target="15" data-suffix="+">0</div>
    <div class="stat-label">Hours saved / client / week<br>via AI automation</div>
  </div>
  <div class="stat-item r">
    <div class="stat-num" data-target="30" data-suffix="%">0%</div>
    <div class="stat-label">Average CAC reduction<br>across client funnels</div>
  </div>
  <div class="stat-item r">
    <div class="stat-num" data-prefix="₹" data-target="80" data-suffix="K+">₹0K+</div>
    <div class="stat-label">D2C brand sales generated<br>solo (3.71x ROAS, 248 orders)</div>
  </div>
  <div class="stat-item r">
    <div class="stat-num" data-target="4795" data-suffix="+">0+</div>
    <div class="stat-label">LinkedIn network & followers<br>(@kuldeepsharma09)</div>
  </div>
</div>

<script is:inline>
  (function initStatsCounter() {
    function runCounter(el) {
      const target = +el.dataset.target;
      const pre = el.dataset.prefix || "";
      const suf = el.dataset.suffix || "";
      const duration = 1800;
      const start = Date.now();
      (function tick() {
        const p = Math.min((Date.now() - start) / duration, 1);
        const ease = 1 - Math.pow(1 - p, 3);
        el.textContent = pre + Math.round(ease * target) + suf;
        if (p < 1) requestAnimationFrame(tick);
      })();
    }
    const statSection = document.querySelector(".stats");
    if (statSection) {
      new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.querySelectorAll("[data-target]").forEach(runCounter);
          }
        });
      }, { threshold: 0.15 }).observe(statSection);
    }
  })();
</script>
