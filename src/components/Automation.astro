<!-- ─── AI AUTOMATION & WORKFLOW PIPELINE ─── -->
<section class="sec" id="automation">
  <div class="r">
    <div class="sec-label">Autonomous Growth Architecture</div>
    <h2 class="sec-title">AI Workflow Pipeline:<br><span>Lead to Booked Call in 60s</span>.</h2>
    <p class="sec-sub">Eliminating manual data entry and sales friction. How bespoke n8n, Make.com, and LLM agent pipelines cut customer acquisition costs by 30% and save 15+ hours weekly.</p>
  </div>

  <div class="pipeline-flow">
    <!-- Step 1 -->
    <div class="pipe-step r">
      <div class="pipe-num">STAGE 01</div>
      <div class="pipe-icon">🎯</div>
      <h4>Multi-Channel Ingestion</h4>
      <p>High-intent prospects captured from Meta Ads, AEO search citations, or web contact triggers instant webhooks in milliseconds.</p>
      <span class="pipe-tag">Instant Webhook Trigger</span>
    </div>

    <!-- Step 2 -->
    <div class="pipe-step r">
      <div class="pipe-num">STAGE 02</div>
      <div class="pipe-icon">🤖</div>
      <h4>Autonomous AI Triage</h4>
      <p>Custom LLM agent enriches company data, analyzes buyer intent, qualifies budget, and scores lead priority in under 10 seconds.</p>
      <span class="pipe-tag">OpenAI / Claude Agents</span>
    </div>

    <!-- Step 3 -->
    <div class="pipe-step r">
      <div class="pipe-num">STAGE 03</div>
      <div class="pipe-icon">⚡</div>
      <h4>CRM & Ops Orchestration</h4>
      <p>n8n automatically syncs enriched data into CRM (HubSpot/Sheets) and pings founders via Slack/WhatsApp with full lead context.</p>
      <span class="pipe-tag">n8n / Make.com Engine</span>
    </div>

    <!-- Step 4 -->
    <div class="pipe-step r">
      <div class="pipe-num">STAGE 04</div>
      <div class="pipe-icon">📅</div>
      <h4>Automated Conversion</h4>
      <p>Qualified leads receive hyper-personalized multi-channel follow-ups, guiding them to self-schedule directly onto the team's calendar.</p>
      <span class="pipe-tag">Zero Human Bottlenecks</span>
    </div>
  </div>

  <!-- Summary Metric Bar -->
  <div class="pipe-summary-bar r">
    <div class="pipe-metric-pill">
      <span class="icon">⚡</span> 15+ Hours Saved / Client / Week
    </div>
    <div class="pipe-metric-pill">
      <span class="icon">📉</span> 30% CAC Reduction
    </div>
    <div class="pipe-metric-pill">
      <span class="icon">⏱️</span> &lt;60s Speed-to-Lead Response
    </div>
    <div class="pipe-metric-pill">
      <span class="icon">🔄</span> 100% Automated CRM Synchronization
    </div>
  </div>
</section>
