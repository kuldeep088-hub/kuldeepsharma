<style>
  .chapters-showcase-list {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
    margin-top: 3.5rem;
  }

  .chapter-showcase-item {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 3.5rem;
    align-items: center;
  }

  .chapter-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
  }

  /* Left Column */
  .chapter-content-col {
    display: flex;
    flex-direction: column;
  }

  .chapter-tag {
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange);
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .chapter-title {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.45rem;
  }

  .chapter-subtitle {
    font-size: 1.05rem;
    color: #94a3b8;
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  .chapter-timeline {
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 500;
    margin-bottom: 1.4rem;
  }

  .chapter-narrative {
    font-size: 0.98rem;
    color: #cbd5e1;
    line-height: 1.7;
    margin-bottom: 1.8rem;
  }

  /* Numbered Points */
  .chapter-points {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.4rem;
  }

  .point-row {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .p-num {
    font-size: 0.82rem;
    font-family: "JetBrains Mono", monospace, sans-serif;
    color: var(--orange);
    font-weight: 800;
    padding-top: 0.15rem;
    flex-shrink: 0;
  }

  .p-text {
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* Stats Row */
  .chapter-stats {
    display: flex;
    gap: 2.5rem;
    row-gap: 1.6rem;
    align-items: flex-start;
    margin-bottom: 1rem;
    padding-top: 0.5rem;
    flex-wrap: wrap;
  }

  .c-stat {
    display: flex;
    flex-direction: column;
  }

  .c-stat-val {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .val-orange {
    color: var(--orange);
  }

  .val-white {
    color: #ffffff;
  }

  .c-stat-lbl {
    font-size: 0.8rem;
    color: #64748b;
    margin-top: 0.45rem;
    max-width: 175px;
    line-height: 1.4;
    font-weight: 500;
  }

  /* Right Column: Visual Photo Collage */
  .chapter-visual-col {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .single-showcase-card {
    position: relative;
    width: 100%;
    max-width: 540px;
    background: #0b0d13;
    border: 1px solid rgba(255, 133, 51, 0.22);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(255, 133, 51, 0.1);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .single-showcase-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 133, 51, 0.55);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.8), 0 0 50px rgba(255, 133, 51, 0.2);
  }

  .single-photo-wrap {
    width: 100%;
    overflow: hidden;
    background: #11141c;
  }

  .single-photo-wrap img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .single-showcase-card:hover .single-photo-wrap img {
    transform: scale(1.025);
  }

  .media-collage-card {
    position: relative;
    width: 100%;
    max-width: 540px;
    background: #0b0d13;
    border: 1px solid rgba(255, 133, 51, 0.22);
    border-radius: 20px;
    padding: 1.2rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(255, 133, 51, 0.1);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .media-collage-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 133, 51, 0.55);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.8), 0 0 50px rgba(255, 133, 51, 0.2);
  }

  .collage-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    border-radius: 14px;
    overflow: hidden;
  }

  .collage-cell {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 10px;
    background: #11141c;
  }

  .collage-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85) contrast(1.05);
    transition: transform 0.5s ease, filter 0.5s ease;
  }

  .media-collage-card:hover .collage-cell img {
    filter: brightness(0.95) contrast(1.05);
    transform: scale(1.04);
  }

  /* Overlapping Center Feature Photo */
  .collage-overlay-photo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72%;
    border-radius: 14px;
    overflow: hidden;
    background: #0f121a;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.85), 0 0 25px rgba(255, 133, 51, 0.15);
    transition: transform 0.4s ease, border-color 0.3s ease;
  }

  .media-collage-card:hover .collage-overlay-photo {
    transform: translate(-50%, -52%) scale(1.03);
    border-color: rgba(255, 133, 51, 0.6);
  }

  .collage-overlay-photo img {
    width: 100%;
    height: auto;
    max-height: 220px;
    object-fit: cover;
    display: block;
  }

  .overlay-caption {
    padding: 0.6rem 0.9rem;
    background: rgba(11, 13, 19, 0.95);
    backdrop-filter: blur(8px);
    font-size: 0.72rem;
    color: #e2e8f0;
