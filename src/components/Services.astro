<!-- ─── SERVICES SECTION ─── -->
<section class="sec" id="services" aria-label="Core Capabilities and Services">
  <div class="r">
    <div class="sec-label">High-Impact Solutions</div>
    <h2 class="sec-title">Enterprise-Grade Growth Systems that<br><span>move the needle</span>.</h2>
    <p class="sec-sub">Transforming manual operations into automated, revenue-producing growth engines with verified unit economics.</p>
  </div>
  <div class="svc-grid">
    <!-- Service 1: Search Architecture -->
    <div class="svc-card r">
      <div class="svc-top">
        <div class="svc-num">01 / SEARCH ARCHITECTURE</div>
        <div class="svc-icon-box">🔍</div>
      </div>
      <h3>SEO · AEO · GEO Optimization</h3>
      <p>Ensure your company dominates both traditional search and next-generation AI engines (ChatGPT, Perplexity, Gemini). I build the semantic architecture that gets you cited as the definitive authority.</p>
      
      <div style="margin-top: 1rem; padding: 0.65rem 0.9rem; background: rgba(255, 133, 51, 0.08); border-left: 2px solid var(--orange); border-radius: 4px; font-size: 0.8rem; color: #fff;">
        <strong style="color: var(--orange);">Proven Impact:</strong> Direct citation in AI synthesized answers & #1 organic rankings.
      </div>

      <div class="svc-tags">
        <span class="svc-tag">Answer Engine Optimization</span>
        <span class="svc-tag">Generative Search</span>
        <span class="svc-tag">Technical SEO</span>
        <span class="svc-tag">Knowledge Graph</span>
