<!-- ─── ABOUT SECTION ─── -->
<section class="sec sec-alt" id="about" aria-label="About Kuldeep Sharma">
  <div class="about-grid">
    <div class="r">
      <div class="sec-label">The Growth Architect</div>
      <h2 class="sec-title">Engineering Systems where<br><span>Creativity Meets Scale</span>.</h2>

      <!-- High-Impact Personal Hook Card -->
      <div class="about-hook-banner">
        <div class="about-hook-top">
          <span class="about-hook-pill"><span>⚡</span> THE OPERATOR'S ORIGIN</span>
          <span style="color: var(--gray); font-size: 0.78rem; font-weight: 600;">Bootstrapped Roots · Autonomous Scale</span>
        </div>
        <p class="about-hook-lead">
          “At 18, while others followed traditional textbooks, I bootstrapped direct-to-consumer e-commerce brands from scratch with <strong>zero outside capital</strong>—mastering conversion architecture, paid customer acquisition at <strong>3.71x ROAS</strong>, and automated fulfillment with my own skin in the game. Today, I don’t just run marketing; I engineer <strong>autonomous growth infrastructure</strong>, AI search omnipresence (AEO · GEO), and high-velocity operational engines that scale modern companies without chaos.”
        </p>
        <div class="about-hook-stats">
          <div class="hook-stat-item">
            <span class="hs-val">₹80.4K+</span>
            <span class="hs-lbl">Solo D2C Genesis @ 18</span>
          </div>
          <div class="hook-stat-item">
            <span class="hs-val">3.71x</span>
            <span class="hs-lbl">Verified Meta ROAS</span>
          </div>
          <div class="hook-stat-item">
            <span class="hs-val">15+ Hrs</span>
            <span class="hs-lbl">Saved / Wk Per Client</span>
          </div>
          <div class="hook-stat-item">
            <span class="hs-val">&lt;60s</span>
            <span class="hs-lbl">Autonomous Speed-to-Lead</span>
          </div>
        </div>
      </div>

      <div class="about-text">
        <p class="about-lead">I build <strong>autonomous growth infrastructure</strong> that turns manual marketing chaos into predictable, measurable revenue engines.</p>

        <p>My work combines three disciplines that rarely meet in a single operator: <strong>generative AI automation</strong>, <strong>semantic search intelligence (AEO · GEO · SEO)</strong>, and <strong>performance-driven paid customer acquisition</strong>.</p>

        <!-- I Work Across Grid -->
        <div class="about-work-across">
          <div class="work-across-title"><span>⚡</span> Core Engineering Domains:</div>
          <div class="work-across-grid">
            <div class="work-across-item">
              <span class="wa-bullet"></span>
              <span><strong>AI Automation Pipelines</strong> (n8n, Make, custom LLM agents)</span>
            </div>
            <div class="work-across-item">
              <span class="wa-bullet"></span>
              <span><strong>Search Intelligence</strong> (Google, ChatGPT, Perplexity, Gemini)</span>
            </div>
            <div class="work-across-item">
              <span class="wa-bullet"></span>
              <span><strong>B2B Lead Architecture</strong> (Automated triage & sub-60s booking)</span>
            </div>
            <div class="work-across-item">
              <span class="wa-bullet"></span>
              <span><strong>Performance Marketing</strong> (Meta Ads scaled at 3.71x ROAS)</span>
            </div>
          </div>
        </div>

        <p style="color: var(--gray-light); font-size: 0.92rem; border-left: 2px solid var(--orange); padding-left: 1rem; margin-top: 1.2rem;">
          Currently Head of Growth Systems & Operations at <strong>Orielix</strong>, previously driving AI search visibility at <strong>Growleads.io</strong>, and studying Computer Science (AI & ML) at <strong>JECRC University</strong>.
        </p>
      </div>

      <!-- High-Impact Value Pillars -->
      <div class="about-highlights-grid" style="margin-top: 1.6rem;">
        <div class="hl-box">
          <div class="hl-icon">⚡</div>
          <h4>15+ Hours Saved / Client</h4>
          <p>Autonomous pipelines eliminating manual CRM data entry and slow lead routing.</p>
        </div>
        <div class="hl-box">
          <div class="hl-icon">📉</div>
          <h4>30% Average CAC Reduction</h4>
          <p>Precision funnel architecture, speed-to-lead triage, and creative testing.</p>
        </div>
        <div class="hl-box">
          <div class="hl-icon">🔮</div>
          <h4>AEO & GEO Omnipresence</h4>
          <p>Structuring authoritative knowledge graphs quoted by modern LLM engines.</p>
        </div>
        <div class="hl-box">
          <div class="hl-icon">🎓</div>
          <h4>Verified AI Credentials</h4>
          <p>Google AI Essentials certified & CS undergraduate in Artificial Intelligence.</p>
        </div>
      </div>

      <div style="margin-top: 2rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
        <a href="#contact" class="btn-p">Let's Discuss Growth →</a>
        <a href="#life" class="btn-s">View My Operating Philosophy ↗</a>
      </div>
    </div>

    <!-- Visual 3D Deck Showcase -->
    <div class="about-visual-col r">
      <div class="about-photo-deck">
        <div class="deck-card deck-card-1">
          <img 
            src="/linkedin_photo.jpg" 
            alt="Kuldeep Sharma - Growth Architect and Head of Operations" 
            width="340" 
            height="420" 
            loading="lazy" 
            decoding="async" 
          />
        </div>
        <div class="deck-card deck-card-2">
          <img 
            src="/images/about-1.jpeg" 
            alt="Kuldeep Sharma in Execution Mode - Growth and AI Workflows" 
            width="340" 
            height="420" 
            loading="lazy" 
            decoding="async" 
            onerror="this.onerror=null;this.src='/All info/Kuldeep.png';" 
          />
        </div>
      </div>
    </div>
  </div>
</section>
